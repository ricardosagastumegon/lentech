# Copia este archivo a .env y llena los valores
# NUNCA subas .env a git

# Wallet que hace el deploy (debe tener CELO para gas)
DEPLOYER_PRIVATE_KEY=0x...

# Treasury wallet (recibe roles MINTER/BURNER/PAUSER)
# Puede ser la misma que deployer en testnet
TREASURY_ADDRESS=0x...

# Compliance wallet (rol AML/blacklist)
COMPLIANCE_ADDRESS=0x...
