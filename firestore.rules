rules_version = '2';

// ─── LEN — Firestore Security Rules ──────────────────────────────────────────
//
// ARQUITECTURA:
//   Toda escritura real pasa por Firebase Admin SDK (API routes server-side).
//   El Admin SDK bypasa estas rules usando la service account.
//   El cliente (navegador) NO tiene acceso directo a ninguna collection de producción.
//
// Deploy: firebase deploy --only firestore:rules
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Collections de producción: solo acceso via Admin SDK ─────────────────
    // El backend (Next.js API routes) usa firebase-admin que bypasa estas rules.
    // Desde el cliente: acceso denegado siempre.

    match /len_users/{userId} {
      allow read, write: if false;
    }

    match /len_transactions/{txId} {
      allow read, write: if false;
    }

    match /len_processed_webhooks/{eventId} {
      allow read, write: if false;
    }

    // ── Demo: los 3 usuarios fijos del sandbox ────────────────────────────────
    // Solo lectura pública para sincronización cross-device en demos.
    // Escritura denegada — el demo no guarda datos sensibles.
    match /len_demo_users/{userId} {
      allow read: if userId in ['demo-gt', 'demo-mx', 'demo-hn'];
      allow write: if false;
    }

    // ── Todo lo demás: denegado ───────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
